# ===== PlantPulse 后端环境变量模板 =====
# 复制为 .env 后按实际环境修改，.env 已被 git 忽略，严禁提交真实密钥

# 运行环境：development / production
ENV=development

# 应用基础信息
APP_NAME=PlantPulse
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库连接串（开发默认 SQLite；生产切换 MySQL，例如：
#   mysql://user:pass@127.0.0.1:3306/plantpulse）
DATABASE_URL=sqlite://./db.sqlite3

# JWT 密钥（生产环境务必改为随机长字符串）
JWT_SECRET=please-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173
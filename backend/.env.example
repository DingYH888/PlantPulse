# ===== PlantPulse 后端环境变量模板 =====
# 复制为 .env 后按实际环境修改，.env 已被 git 忽略，严禁提交真实密钥

# 运行环境：development / production
ENV=development

# 应用基础信息
APP_NAME=PlantPulse
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库连接串（MySQL 8；本地开发账号 root。开发调试可切换 SQLite：
#   sqlite://./db.sqlite3）
DATABASE_URL=mysql://root:123456@127.0.0.1:3306/plantpulse?charset=utf8mb4

# JWT 密钥（生产环境务必改为随机长字符串）
# 单 token 方案：登录签发一个 JWT，有效期 ACCESS_TOKEN_EXPIRE_DAYS 天
JWT_SECRET=please-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# 图形验证码有效期（分钟）
CAPTCHA_EXPIRE_MINUTES=5

# CORS 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173
# ===== AI 模块（LangChain + ChromaDB + 百炼 OpenAI 兼容接口）=====
# 密钥从阿里云百炼控制台获取，严禁提交真实值
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL_FALLBACK=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-omni-flash
# 视觉模型留空表示复用 LLM_MODEL
LLM_VISION_MODEL=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1800
# false=发送 enable_thinking=false 关闭思考（更快）；接口不支持该参数时改为 true
LLM_ENABLE_THINKING=false

# 地址切换开关：false=主地址；true=备用 dashscope 地址
AI_USE_FALLBACK_BASE_URL=false

EMBEDDING_API_KEY=sk-xxxxxxxx
EMBEDDING_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL_FALLBACK=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_TIMEOUT_SECONDS=30

# 知识库与向量库
KNOWLEDGE_DIR=../docs/knowledge_base
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=plant_knowledge

# RAG 调参（实测 60 品种知识库调优值；PRD 默认 top_k=5 / 阈值=0.45）
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.55

# AI 链路超时（PRD 目标 30s；MaaS 生成较慢时放宽到 120s）
AI_TIMEOUT_SECONDS=120
AI_MEMORY_MAX_TURNS=10
AI_RATE_LIMIT_PER_MINUTE=5